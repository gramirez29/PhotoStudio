{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://develop-api.photosensestudio.com",
        "EXPO_PUBLIC_STUDIO_URL": "https://develop.photosensestudio.com/studio"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "development",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://develop-api.photosensestudio.com",
        "EXPO_PUBLIC_STUDIO_URL": "https://develop.photosensestudio.com/studio"
      }
    }
  }
}
