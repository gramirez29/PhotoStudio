{
  "expo": {
    "name": "PhotoSense Studio",
    "slug": "photostudio",
    "scheme": "photostudio",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.photosensestudio.app"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.photosensestudio.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020d2c"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#020d2c"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6560ba0b-780b-4028-8ae8-382869e88e34"
      }
    },
    "owner": "g.raba29-dev",
    "icon": "./assets/icon.png"
  }
}
