# Copy to .env and adjust. Variables prefixed with EXPO_PUBLIC_ are embedded in the app bundle: never put secrets here.
# On a physical device use your computer LAN IP instead of localhost (for example http://192.168.1.50:8080).
EXPO_PUBLIC_API_URL=http://localhost:8080
# Address of the web area of the photographer, opened from the home screen (optional; the link is hidden without it).
# EXPO_PUBLIC_STUDIO_URL=https://develop.photosensestudio.com/studio
