# Copy to .env and adjust. Variables prefixed with EXPO_PUBLIC_ are embedded in the app bundle: never put secrets here.
# On a physical device use your computer's LAN IP instead of localhost (for example http://192.168.1.50:8080).
EXPO_PUBLIC_API_URL=http://localhost:8080
# Photographer whose bookings the app lists. Temporary until photographer sign-in exists; the identifier is not a secret.
EXPO_PUBLIC_PHOTOGRAPHER_ID=00000000-0000-0000-0000-000000000000
