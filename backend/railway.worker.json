{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["/backend/**"]
  },
  "deploy": {
    "startCommand": "dotnet worker/PhotoStudio.Worker.dll",
    "cronSchedule": "*/15 * * * *",
    "restartPolicyType": "NEVER"
  }
}
