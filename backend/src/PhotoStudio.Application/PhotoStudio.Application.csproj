<Project Sdk="Microsoft.NET.Sdk">

  <!-- Application layer: use cases, ports (interfaces) and response DTOs. Depends only on the Domain. -->
  <PropertyGroup>
    <RootNamespace>PhotoStudio.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoStudio.Domain\PhotoStudio.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- The contract templates ship inside the assembly; a version is immutable once a client has signed it. -->
  <ItemGroup>
    <EmbeddedResource Include="Contracts\Templates\*.md" LogicalName="PhotoStudio.Application.Contracts.Templates.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PhotoStudio.Application.UnitTests" />
  </ItemGroup>

</Project>
